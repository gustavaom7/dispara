{
  "name": "dispara",
  "version": "0.1.0",
  "private": true,
  "description": "Catálogo self-service de testes Playwright contra o Toolshop: qualquer pessoa do time escolhe ambiente e conta de teste e roda na própria máquina.",
  "scripts": {
    "t": "node scripts/rodar.mjs",
    "publicar": "node scripts/publicar.mjs",
    "sync": "node scripts/sincronizar.mjs",
    "site": "node scripts/gerar-site.mjs",
    "coletar": "node scripts/coletar-resultados.mjs",
    "mapear": "node scripts/mapear-toolshop.mjs",
    "checar": "node scripts/checar-seletores.mjs",
    "tipos": "tsc -p tsconfig.json",
    "test:scripts": "node --test scripts/lib/*.test.mjs scripts/lib/ia/*.test.mjs",
    "gerar": "node scripts/gerar-testes.mjs",
    "aprovar": "node scripts/aprovar.mjs",
    "resumo": "node scripts/resumo-ci.mjs",
    "triar": "node scripts/triar.mjs",
    "lint": "eslint .",
    "checar:rascunhos": "node scripts/checar-rascunhos.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "eslint-plugin-playwright": "^2.1.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.18.0"
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.130.0",
    "@axe-core/playwright": "^4.10.1"
  }
}
